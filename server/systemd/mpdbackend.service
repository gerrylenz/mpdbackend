[Unit]
Description=MPD Backend metadata service for Music Assistant
After=network.target mpd.service
Wants=mpd.service

[Service]
Type=simple
User=gerry
Group=gerry
EnvironmentFile=-/home/gerry/projects/mpdbackend/server/mpdbackend.env
WorkingDirectory=/home/gerry/projects/mpdbackend/server
ExecStart=/home/gerry/projects/mpdbackend/server/venv/bin/python /home/gerry/projects/mpdbackend/server/mpdbackend.py
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
