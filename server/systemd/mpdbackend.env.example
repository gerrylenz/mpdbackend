# Copy to /etc/mpdbackend.env (systemd) or use ./mpdbackend.env next to mpdbackend.py
# MQTT: set MPDBACKEND_MQTT_ENABLED=true and configure broker credentials below.

MPDBACKEND_MQTT_ENABLED=true
MPDBACKEND_MQTT_BROKER=home.example.com
MPDBACKEND_MQTT_PORT=1883
MPDBACKEND_MQTT_USERNAME=
MPDBACKEND_MQTT_PASSWORD=
MPDBACKEND_MQTT_TOPIC_STATE=mpdbackend/state
MPDBACKEND_MQTT_TOPIC_COVER=mpdbackend/cover
MPDBACKEND_MQTT_TOPIC_CURRENT=mpdbackend/current
MPDBACKEND_MQTT_TOPIC_ELAPSED=mpdbackend/elapsed
# Poll-Intervall für elapsed aus MPD (Sekunden, nur bei MQTT aktiv)
MPDBACKEND_MQTT_ELAPSED_INTERVAL=1
# Steuerung: Plain-Text auf mpdbackend/cmd/player (play|stop|next|back)
# Playlist laden: Plain-Text auf mpdbackend/cmd/playlist (z. B. Pop.m3u)
# Status: mpdbackend/state (JSON: title/artist/album/duration „M:SS“, cover_name), mpdbackend/current, mpdbackend/elapsed, mpdbackend/connected
MPDBACKEND_MQTT_TOPIC_CMD_PLAYER=mpdbackend/cmd/player
MPDBACKEND_MQTT_TOPIC_CMD_PLAYLIST=mpdbackend/cmd/playlist
# Verfügbarkeit für HA (online/offline, LWT)
MPDBACKEND_MQTT_TOPIC_CONNECTED=mpdbackend/connected

MPDBACKEND_MPD_SOCKET=/run/mpd/socket
# Optional; default: playlist_directory from MPD config
# MPDBACKEND_PLAYLIST_DIR=/var/lib/mpd/playlists
MPDBACKEND_MUSIC_ROOT=/home/musik
# User-writable paths (adjust user/home as needed):
MPDBACKEND_COVER_DIR=__INSTALL_DIR__/data/covers
MPDBACKEND_STATION_LOGO_DIR=__INSTALL_DIR__/data/logos
# Optional override; default is channels.json next to mpdbackend.py
# MPDBACKEND_CHANNELS_FILE=__INSTALL_DIR__/channels.json

MPDBACKEND_PUBLIC_BASE_URL=http://host.example.com:4533
MPDBACKEND_HTTP_PORT=4533

# Install (from server directory):
#   cd /path/to/server && ./install/install.sh --systemd
