# Example env for a second mpdbackend instance (mpdbackend_1.service).
# Copy to mpdbackend_1.env and adjust paths/credentials (file is gitignored).

MPDBACKEND_MQTT_ENABLED=false
MPDBACKEND_MQTT_ELAPSED_INTERVAL=1

MPDBACKEND_MQTT_BROKER=home.example.com
MPDBACKEND_MQTT_PORT=1883
MPDBACKEND_MQTT_USERNAME=
MPDBACKEND_MQTT_PASSWORD=
MPDBACKEND_MQTT_TOPIC_STATE=mpdbackend/state
MPDBACKEND_MQTT_TOPIC_COVER=mpdbackend/cover

MPDBACKEND_MPD_SOCKET=/run/mpd/socket_1
MPDBACKEND_MUSIC_ROOT=/home/musik
MPDBACKEND_COVER_DIR=/opt/mpdbackend/data/covers
MPDBACKEND_STATION_LOGO_DIR=/opt/mpdbackend/data/logos
MPDBACKEND_CHANNELS_FILE=/opt/mpdbackend/channels.json

# MPDBACKEND_WEB_PASSWORD=geheim

MPDBACKEND_PUBLIC_BASE_URL=http://127.0.0.1:4534
MPDBACKEND_HTTP_PORT=4534
