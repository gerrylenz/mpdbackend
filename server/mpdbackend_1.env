# MQTT: set MPDBACKEND_MQTT_ENABLED=true and configure broker credentials below.
MPDBACKEND_MQTT_ENABLED=false

# Poll-Intervall für elapsed aus MPD (Sekunden, nur bei MQTT aktiv)
MPDBACKEND_MQTT_ELAPSED_INTERVAL=1

MPDBACKEND_MQTT_BROKER=home.ex-store.de
MPDBACKEND_MQTT_PORT=1883
MPDBACKEND_MQTT_USERNAME=gerry
MPDBACKEND_MQTT_PASSWORD=abelsleben
MPDBACKEND_MQTT_TOPIC_STATE=mpdbackend/state
MPDBACKEND_MQTT_TOPIC_COVER=mpdbackend/cover

MPDBACKEND_MPD_SOCKET=/run/mpd/socket_1
MPDBACKEND_MUSIC_ROOT=/home/musik
MPDBACKEND_COVER_DIR=/home/gerry/scripts/mpdbackend/data/covers
MPDBACKEND_STATION_LOGO_DIR=/home/gerry/scripts/mpdbackend/data/logos
MPDBACKEND_CHANNELS_FILE=/home/gerry/scripts/mpdbackend/channels.json

MPDBACKEND_WEB_PASSWORD=abelsleben

MPDBACKEND_PUBLIC_BASE_URL=http://edeka.ex-store.de:4534
MPDBACKEND_HTTP_PORT=4534
