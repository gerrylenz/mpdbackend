type: custom:button-card
entity: sensor.mpd_workplayer_title
show_name: false
show_state: false
show_icon: false
aspect_ratio: 1/1
styles:
  grid:
    - grid-template-areas: "\"status\" \".\" \"info\" \"time\""
    - grid-template-rows: min-content 1fr min-content min-content
    - grid-template-columns: 1fr
  card:
    - padding: 20px
    - border-radius: 24px
    - overflow: hidden
    - position: relative
    - color: white
    - background-size: cover
    - background-position: center
    - background-image: |
        [[[
          return `
            linear-gradient(
              rgba(0,0,0,0.25),
              rgba(0,0,0,0.70)
            ),
            url('${states['image.mpd_cover'].attributes.entity_picture}')
          `;
        ]]]
  custom_fields:
    status:
      - justify-self: center
      - align-self: start
      - font-size: 15px
      - font-weight: 700
      - letter-spacing: 2px
      - text-shadow: 0 2px 8px rgba(0,0,0,0.8)
    info:
      - align-self: end
      - width: 100%
    time:
      - justify-self: center
      - align-self: end
custom_fields:
  status: |
    [[[
      let state = states['sensor.mpd_workplayer_state'].state;

      if (state === 'play')
        return 'PLAYING';

      if (state === 'pause')
        return 'PAUSED';

      return 'STOPPED';
    ]]]
  info: |
    [[[
      return `
        <div style="
          text-align:center;
          backdrop-filter: blur(14px);
          background: rgba(0,0,0,0.35);
          border-radius:18px;
          padding:16px;
        ">
          <div style="
            font-size:34px;
            font-weight:700;
            line-height:1.3;
            margin-bottom:3px;
          ">
            ${states['sensor.mpd_workplayer_title'].state}
          </div>

          <div style="
            font-size:16px;
            opacity:0.92;
          ">
            ${states['sensor.mpd_workplayer_artist'].state}
          </div>

          <div style="
            text-align:center;
            font-size:14px;
            margin-top:1px;
            opacity:0.9;
            text-shadow:0 2px 8px rgba(0,0,0,0.8);
          ">
            No.:${states['sensor.mpd_workplayer_song_nr'].state}
             - ${states['sensor.mpd_workplayer_time'].state}
             / ${states['sensor.mpd_workplayer_duration'].state}
          </div>

        </div>
      `;
    ]]]
