type: horizontal-stack
cards:
  - show_name: false
    show_icon: true
    type: button
    tap_action:
      action: perform-action
      data:
        qos: "1"
        topic: mpdbackend/cmd/player
        payload: back
      target: {}
      perform_action: mqtt.publish
    icon: mdi:skip-previous
    icon_height: 42px
    name: Back
  - show_name: false
    show_icon: true
    type: button
    tap_action:
      action: perform-action
      data:
        qos: "1"
        topic: mpdbackend/cmd/player
        payload: play
      target: {}
      perform_action: mqtt.publish
    icon: mdi:play
    name: Play
    icon_height: 42px
  - show_name: false
    show_icon: true
    type: button
    tap_action:
      action: perform-action
      data:
        qos: "1"
        topic: mpdbackend/cmd/player
        payload: stop
      target: {}
      perform_action: mqtt.publish
    icon: mdi:pause
    name: Stop
    icon_height: 42px
  - show_name: false
    show_icon: true
    type: button
    tap_action:
      action: perform-action
      data:
        qos: "1"
        topic: mpdbackend/cmd/player
        payload: next
      target: {}
      perform_action: mqtt.publish
    icon: mdi:skip-next
    icon_height: 42px
    name: Next
