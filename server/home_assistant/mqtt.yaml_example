##################################################################################################################################  
image:
  - name: "MPD Cover"
    image_topic: "mpdbackend/cover"
##################################################################################################################################  
number:
  - unique_id: "mpd_workplayer_volume"
    name: "MPD Workplayer Volume"
    state_topic: "mpdbackend/state"
    value_template: "{{ value_json.volume | default(0) | int }}"
    command_topic: "mpdbackend/cmd/volume"
    command_template: "{{ value | int }}"
    min: 0
    max: 100
    step: 5
    mode: slider
  - unique_id: "mpd_home_volume"
    name: "MPD Home Volume"
    state_topic: "mpd/status"
    value_template: "{{ value_json.volume | default(0) | int }}"
    command_topic: "mpd//volume/set"
    command_template: '{"volume": "{{ value | int }}" }'
    min: 0
    max: 100
    step: 5
    mode: slider
##################################################################################################################################  
sensor:
  - name: mpd_workplayer_playlists
    unique_id: mpd_workplayer_playlists
    state_topic: mpdbackend/playlists
    value_template: "{{ value_json.playlists | length }}"
    json_attributes_topic: mpdbackend/playlists
##################################################################################################################################  
